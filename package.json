{
  "name": "contractbot",
  "version": "0.1.1",
  "description": "Review approved OpenAPI contract changes and verify compatibility in CI.",
  "type": "module",
  "bin": {
    "contractbot": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack": "node scripts/smoke-pack.mjs",
    "check": "npm test && npm run build && npm run test:pack",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "api",
    "openapi",
    "swagger",
    "breaking-changes",
    "contract",
    "api-compatibility",
    "contract-testing",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "optimusbuilder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optimusbuilder/contractbot.git"
  },
  "bugs": {
    "url": "https://github.com/optimusbuilder/contractbot/issues"
  },
  "homepage": "https://github.com/optimusbuilder/contractbot#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.7.1",
    "chalk": "^5.4.1",
    "ora": "^8.2.0",
    "ts-morph": "^25.0.0",
    "openai": "^4.86.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "glob": "^11.0.1",
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.19.4",
    "vitest": "^3.2.1",
    "@types/node": "^22.15.0",
    "@types/diff": "^7.0.2"
  }
}
